# Public URL of this server (used in approval links and MCP URLs). Use your tunnel / AWS URL.
BHAROSA_BASE_URL=http://localhost:8000

# Storage: sqlite (default) or dynamodb
BHAROSA_STORE=sqlite
BHAROSA_SQLITE_PATH=bharosa.db
BHAROSA_DYNAMODB_TABLE=bharosa
AWS_REGION=ap-south-1

# Optional: require this token to create households via /setup or the API
BHAROSA_ADMIN_TOKEN=

# Guardian alerts: ntfy push is per-household (set the topic at setup). SMS via Amazon SNS:
BHAROSA_SNS_SMS=false
BHAROSA_NTFY_SERVER=https://ntfy.sh

# Optional Amazon Bedrock second opinion for scam detection (can only raise risk), e.g.
# BHAROSA_BEDROCK_MODEL_ID=apac.amazon.nova-lite-v1:0
BHAROSA_BEDROCK_MODEL_ID=

# Real phone calls through ElevenLabs Agents (leave "simulated" to run without them)
BHAROSA_PHARMACY_CHANNEL=simulated      # simulated | elevenlabs
BHAROSA_CALLBACK_CHANNEL=simulated      # simulated | elevenlabs
ELEVENLABS_API_KEY=
ELEVENLABS_PARENT_AGENT_ID=
ELEVENLABS_PHARMACY_AGENT_ID=
ELEVENLABS_PHONE_NUMBER_ID=
ELEVENLABS_TELEPHONY=twilio             # twilio | sip
ELEVENLABS_WEBHOOK_SECRET=
